# BetterAuth requires a strong secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Recommended for deployment: use Neon/Supabase/Postgres and paste the connection URL.
# Local development can run without this because the project falls back to SQLite.
DATABASE_URL="postgres://user:password@host:5432/database"

# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
